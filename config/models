Board json sql=boards
    name String
    color BoardColor default='Red'
    position Int default=0
    deriving Eq Read Show

Task json sql=tasks
    boardId BoardId
    name String
    points Int default=1
    status TaskStatus default='Todo'
    deriving Eq Read Show

